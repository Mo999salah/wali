# Maintainer: Mohamad Salah <kozomakk@gmail.com>

pkgname=wali-bin
pkgver=0.1.1
pkgrel=1
pkgdesc='Lightweight unofficial WhatsApp desktop client for Linux'
arch=('x86_64')
url='https://github.com/Mo999salah/wali'
license=('MIT')
depends=(
  'gtk3'
  'libayatana-appindicator'
  'webkit2gtk-4.1'
  'xdg-utils'
)
provides=('wali')
conflicts=('wali')
options=('!debug' '!strip')
source=("https://github.com/Mo999salah/wali/releases/download/v${pkgver}/Wali_${pkgver}_amd64.deb")
sha256sums=('80e5366a713e74171734a02a2cb7fee29e962f66afa3da3d15e2ac0283f70acf')
noextract=("Wali_${pkgver}_amd64.deb")

package() {
  bsdtar -xOf "Wali_${pkgver}_amd64.deb" data.tar.gz | bsdtar -xf - -C "${pkgdir}"
}
